#!/usr/bin/env python3
"""Paint every OpenRGB device with a single colour derived from the Omarchy theme.

Reads the active theme's `accent` unless a colour is given explicitly, lifts it
into a range an LED can actually render, and pushes it to all devices in Direct
mode.

Why lift at all: RGB LEDs desaturate hard at brightness, so a pastel that reads
as blue on a monitor renders as dim white on a keyboard. Roughly a third of the
stock themes ship an accent below 0.35 saturation.

Why lift by remapping rather than clamping: a hard `max(S, floor)` throws away
every distinction below the floor, and with V pinned to 1.0 the entire output
collapsed onto a single ring where only hue survived. Fourteen of the 22 stock
accents sit in the 130-240 degree arc, so neighbouring themes came out visually
identical -- `lumon` and `solitude` landed 4 dE76 apart, which reads as "the
theme changed but the LEDs didn't". Remapping S and V into [floor, 1] instead
keeps the ordering, so two themes that differ on screen still differ on the
hardware.

Greys (S == 0, e.g. the `vantablack` and `white` themes) keep their hue-less
neutrality on purpose -- there is no hue to recover -- but still get the
brightness lift, which is what keeps them apart from each other.
"""

import argparse
import colorsys
import json
import os
import re
import shutil
import subprocess
import sys

THEME_COLORS = os.path.expanduser(
    "~/.local/state/omarchy/current/theme/colors.toml"
)
SHELL_CONFIG = os.path.expanduser("~/.config/omarchy/shell.json")
PLUGIN_ID = "perfektnacht.openrgb-theme"
SERVER_HOST = "127.0.0.1"
SERVER_PORT = 6742
# What the openrgb client prints once it has reached a running server; its
# absence is how a fallback to direct hardware access is detected.
SERVER_BANNER = "Connected to server"

DEFAULTS = {
    "saturate": True,
    # Both are the bottom of a remapped range, not a clamp -- see adjust(). They
    # sit below the old clamp values (0.7 / 1.0) because the headroom above them
    # is what carries one theme's accent away from the next one's.
    "minSaturation": 0.55,
    "minValue": 0.65,
    "brightness": None,
    # Empty by default: Static costs an onboard flash write per theme change,
    # so which devices need it is a per-machine decision. See build_command.
    "staticDevices": [],
}


def settings():
    """Read this plugin's knobs from its shell.json entry.

    Config lives here rather than in the QML service on purpose. The service
    shells out to this script on every apply, so reading the file here means the
    settings are always current without a file watcher -- and Quickshell's
    FileView misses truncate-and-rewrite updates (`cp`, and some editors),
    which made the watched version silently serve stale config.
    """
    values = dict(DEFAULTS)
    try:
        with open(SHELL_CONFIG) as handle:
            config = json.load(handle)
    except (OSError, ValueError):
        return values

    entries = config.get("plugins")
    if not isinstance(entries, list):
        return values

    for entry in entries:
        if not isinstance(entry, dict) or entry.get("id") != PLUGIN_ID:
            continue
        if isinstance(entry.get("saturate"), bool):
            values["saturate"] = entry["saturate"]
        for key in ("minSaturation", "minValue"):
            if isinstance(entry.get(key), (int, float)):
                values[key] = float(entry[key])
        if isinstance(entry.get("brightness"), int):
            values["brightness"] = entry["brightness"]
        if isinstance(entry.get("staticDevices"), list):
            values["staticDevices"] = [
                item for item in entry["staticDevices"]
                if isinstance(item, str) and item.strip()
            ]
        break

    return values


def theme_accent():
    """Pull `accent` out of the active theme's colors.toml."""
    try:
        with open(THEME_COLORS) as handle:
            raw = handle.read()
    except OSError as err:
        sys.exit(f"cannot read {THEME_COLORS}: {err}")

    match = re.search(r'^\s*accent\s*=\s*"([^"]+)"', raw, re.M)
    if not match:
        sys.exit(f"no accent key in {THEME_COLORS}")
    return match.group(1)


def parse_hex(value):
    text = value.strip().lstrip("#")
    if len(text) == 3:
        text = "".join(ch * 2 for ch in text)
    if not re.fullmatch(r"[0-9a-fA-F]{6}", text):
        sys.exit(f"not a hex colour: {value}")
    return tuple(int(text[i:i + 2], 16) / 255 for i in (0, 2, 4))


def adjust(rgb, min_sat, min_val):
    """Lift S and V into [floor, 1], preserving hue and relative ordering.

    The remap is a plain lerp: 0 lands on the floor, 1 stays at 1. Every input
    still clears the floor -- that is the whole point of the floor -- but the
    distance between two accents is compressed rather than erased, so themes
    that differ only in how washed-out they are stay distinguishable.
    """
    hue, sat, val = colorsys.rgb_to_hsv(*rgb)

    # A pure grey carries no hue. Lifting S would invent a colour the theme
    # never chose, so only the brightness lift applies.
    if sat > 0:
        sat = min_sat + sat * (1.0 - min_sat)
    val = min_val + val * (1.0 - min_val)

    return colorsys.hsv_to_rgb(hue, sat, val)


def to_hex(rgb):
    return "".join(f"{round(channel * 255):02X}" for channel in rgb)


def inventory():
    """Every detected device as an (index, name, location) record.

    One --list-devices call serves both the name matching and the staleness
    check below, so neither costs an extra connection. Returns None when the
    listing could not be read at all.
    """
    result = subprocess.run(
        ["openrgb", "--list-devices"],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
    )
    if result.returncode != 0:
        sys.stderr.write(result.stdout)
        return None

    # Device headers sit at column 0 as "<index>: <name>"; every detail line for
    # a device is indented, and the client's own chatter is not digit-prefixed.
    header = re.compile(r"^(\d+):[ \t]+(.+)$")
    # Only HID locations name a file we can check. DRAM sits behind an I2C
    # address, which is not a path and says nothing about handle validity.
    location = re.compile(r"^\s+Location:\s*HID:\s*(\S+)")

    records = []
    for line in result.stdout.splitlines():
        found = header.match(line)
        if found:
            records.append({
                "index": int(found.group(1)),
                "name": found.group(2).strip(),
                "location": None,
            })
            continue
        if not records:
            continue
        found = location.match(line)
        if found:
            records[-1]["location"] = found.group(1)

    return records


def stale_devices(records):
    """Devices whose cached HID node has since disappeared.

    OpenRGB opens an LED interface once at detection and holds the descriptor
    for the life of the server. When USB re-enumerates -- connecting a gamepad
    is enough -- the node can return under a new number, and writes to the old
    one are accepted and silently discarded: the server goes on reporting the
    mode it believes it set while the hardware runs its stored effect, which
    looks exactly like the plugin not working.

    Not every controller reports a location (Logitech's keyboard does not), so a
    missing one is not evidence of a problem and is skipped. A device that does
    report a dead path is evidence the server's whole detection pass is stale.
    """
    return [
        record for record in records
        if record["location"] and not os.path.exists(record["location"])
    ]


def match_devices(records, patterns):
    """Resolve name substrings to device indices.

    Matching on names rather than indices is deliberate: OpenRGB numbers devices
    in detection order, so an index moves when unrelated hardware comes or goes.
    Indices are then read back out of the same listing, which avoids openrgb's
    own `-d "name"` search -- that needs three characters, can match more than
    one device, and hard-fails the entire invocation on a miss.

    Returns (matched, missing): pairs of (index, name), and the patterns that
    matched nothing so the caller can say so.
    """
    matched = {}
    missing = []
    for pattern in patterns:
        needle = pattern.lower()
        hits = [
            (record["index"], record["name"]) for record in records
            if needle in record["name"].lower()
        ]
        if hits:
            matched.update(dict.fromkeys(hits))
        else:
            missing.append(pattern)

    return sorted(matched), missing


def build_command(hex_color, brightness, assignments):
    """One openrgb invocation that gives each device its own mode.

    Why Static for some devices: Direct is a live mode, driven by the host for
    as long as it keeps writing. This helper runs once per theme change and
    exits, so on a device whose effects live in firmware Direct either reverts
    to the stored effect once the writer goes away -- Logitech's keyboard, back
    to its rainbow -- or never renders the full chain in the first place. MSI's
    ARGB headers do the latter: Direct streams per-LED and the board drops the
    tail of the chain, so case fans daisy-chained off JRAINBOW sit dark while
    the rest of the board takes the colour. Static hands the chain to the
    board's own MCU, which drives all of it.

    Why one invocation rather than a global Direct pass plus a Static
    correction: on those MSI headers Direct is not merely the wrong colour, it
    is no colour, so the two-pass version blinked the fans off for as long as
    the second invocation took to connect -- about a second. -d repeats with its
    own mode and colour, so a single command covers both sets at once.

    assignments of None means the device listing was unavailable; fall back to
    the global pass, which addresses every device without needing indices.
    """
    command = ["openrgb"]

    if assignments is None:
        command += ["--mode", "direct", "--color", hex_color]
        if brightness is not None:
            command += ["--brightness", str(brightness)]
        return command

    # Devices are addressed by index because openrgb's own -d name search needs
    # three characters, can match more than one device, and hard-fails the whole
    # invocation on a miss.
    for index, mode in assignments:
        command += ["--device", str(index), "--mode", mode, "--color", hex_color]
        if brightness is not None:
            command += ["--brightness", str(brightness)]

    return command


def plan(records, patterns):
    """Pair every detected device with the mode it should be sent.

    Returns None when the listing could not be read, which sends the caller
    down the global-Direct fallback.
    """
    if records is None:
        return None

    for record in stale_devices(records):
        sys.stderr.write(
            f"openrgb is holding a stale handle for {record['name']!r}: "
            f"{record['location']} no longer exists. Colours are being "
            "accepted and discarded; the server needs to re-detect. "
            "Fix with: systemctl --user restart openrgb-server.service\n"
        )

    matched, missing = match_devices(records, patterns)
    for pattern in missing:
        sys.stderr.write(
            f"staticDevices: no connected device matches {pattern!r}\n"
        )

    static = {index for index, _ in matched}
    return [
        (record["index"], "static" if record["index"] in static else "direct")
        for record in records
    ]


def apply(hex_color, brightness, assignments, dry_run):
    # No --client flag: bare openrgb autoconnects to a local server already, and
    # passing --client on top of that connects twice and applies to every device
    # twice over. Without a server this falls back to direct hardware access,
    # which still works -- it just pays for a full SMBus rescan each time.
    command = build_command(hex_color, brightness, assignments)

    if dry_run:
        print(" ".join(command))
        return 0

    result = subprocess.run(
        command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True
    )
    if result.returncode != 0:
        sys.stderr.write(result.stdout)
        return result.returncode

    # Whether we reached the server is read off the client's own output rather
    # than probed beforehand. A pre-flight connect() that never sends the ORGB
    # magic makes the server log "recv_select failed receiving magic" on every
    # apply -- the probe was doubling this plugin's contribution to the journal
    # for information the client already reports.
    if SERVER_BANNER not in result.stdout:
        sys.stderr.write(
            "openrgb server not reachable on "
            f"{SERVER_HOST}:{SERVER_PORT}; fell back to direct access "
            "(slow)\n"
        )

    return result.returncode


def main():
    parser = argparse.ArgumentParser(
        description="Match OpenRGB devices to the current Omarchy theme."
    )
    parser.add_argument(
        "--color", help="hex colour to apply; defaults to the theme accent"
    )
    # Defaults are None so "flag absent" stays distinguishable from "flag set to
    # the default value"; the shell.json entry fills in whatever is left.
    parser.add_argument(
        "--min-sat", type=float,
        help="bottom of the remapped saturation range, 0-1 (default: 0.55)",
    )
    parser.add_argument(
        "--min-val", type=float,
        help="bottom of the remapped HSV brightness range, 0-1 (default: 0.65)",
    )
    parser.add_argument(
        "--no-saturate", action="store_true",
        help="send the theme colour untouched",
    )
    parser.add_argument(
        "--brightness", type=int,
        help="device brightness percentage, 0-100, where supported",
    )
    parser.add_argument(
        "--print-settings", action="store_true",
        help="print the effective settings as JSON and exit",
    )
    parser.add_argument(
        "--dry-run", action="store_true",
        help="print the openrgb command instead of running it",
    )
    parser.add_argument(
        "--print", dest="print_only", action="store_true",
        help="print the resolved colour and exit",
    )
    args = parser.parse_args()

    # shell.json is the baseline; explicit flags win over it.
    config = settings()
    if args.no_saturate:
        config["saturate"] = False
    if args.min_sat is not None:
        config["minSaturation"] = args.min_sat
    if args.min_val is not None:
        config["minValue"] = args.min_val
    if args.brightness is not None:
        config["brightness"] = args.brightness

    if args.print_settings:
        print(json.dumps(config))
        return 0

    if not shutil.which("openrgb"):
        sys.exit("openrgb is not installed")

    source = args.color or theme_accent()
    rgb = parse_hex(source)

    if not config["saturate"]:
        final = to_hex(rgb)
    else:
        min_sat = min(max(config["minSaturation"], 0.0), 1.0)
        min_val = min(max(config["minValue"], 0.0), 1.0)
        final = to_hex(adjust(rgb, min_sat, min_val))

    if args.print_only:
        print(f"{source} -> #{final}")
        return 0

    # The device listing is only needed to address devices individually, which
    # is only needed when some of them want a mode other than Direct. Without
    # staticDevices the global pass is already correct, and skipping the listing
    # keeps the common case at a single openrgb invocation.
    assignments = None
    if config["staticDevices"]:
        assignments = plan(inventory(), config["staticDevices"])

    # apply() has already written openrgb's own output to stderr on a failure.
    code = apply(final, config["brightness"], assignments, args.dry_run)

    # Report the colour that actually reached the hardware, post-saturation, so
    # the QML service can record that rather than the raw accent it asked for.
    if code == 0 and not args.dry_run:
        print(final)

    return code


if __name__ == "__main__":
    sys.exit(main())
